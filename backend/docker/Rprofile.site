#    repos = c(CRAN = 'https://packagemanager.rstudio.com/cran/__linux__/jammy/2023-04-03'),
#    download.file.method = 'libcurl'
#)


options(
    repos = c(CRAN = 'https://cran.rstudio.com/'),
    download.file.method = 'libcurl'
)

# https://docs.rstudio.com/rspm/admin/serving-binaries/#binaries-r-configuration-linux
options(
    HTTPUserAgent = sprintf(
        "R/%s R (%s)",
        getRversion(),
        paste(
            getRversion(),
            R.version["platform"],
            R.version["arch"],
            R.version["os"]
        )
    )
)
# Set the default HTTP user agent
options(download.file.extra = sprintf("--header \"User-Agent: R (%s)\"", paste(getRversion(), R.version["platform"], R.version["arch"], R.version["os"])))
